# OpenFEC API Key (get one at https://api.open.fec.gov/developers/)
# This is required for fetching live FEC campaign finance data
VITE_OPENFEC_API_KEY=your_api_key_here

# Supabase Configuration
# Get your project URL and anon key from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
